import os
import sys
import argparse
import datetime
import shutil
import subprocess
import re
import struct

def parse_hex(s):
    """Parses flexible hex strings into bytes."""
    s = s.lower().replace('0x', '').replace(',', ' ')
    s = ''.join(s.split())
    if len(s) % 2 != 0:
        raise ValueError("Hex string must have an even number of characters (e.g. '05' instead of '5').")
    return bytes.fromhex(s)

def parse_offset(s):
    """Parses offset strings. ALWAYS treats input as Hexadecimal."""
    s = s.strip().lower()
    if s.startswith('0x'):
        s = s[2:]
    try:
        return int(s, 16)
    except ValueError:
        raise ValueError(f"Invalid hex offset format: {s}")

def print_hexdump(data, match_offset, match_len):
    """Prints an xxd-style hex dump highlighting the matched bytes."""
    start_line = match_offset & ~0xF
    end_line = (match_offset + match_len - 1) & ~0xF

    for i in range(start_line, end_line + 16, 16):
        chunk = data[i:i+16]
        if not chunk: 
            break
        
        hex_str = ''
        caret_str = ''
        for j, b in enumerate(chunk):
            curr = i + j
            hex_str += f"{b:02x} "
            if j == 7: hex_str += " "
            
            if match_offset <= curr < match_offset + match_len:
                caret_str += "^^ "
            else:
                caret_str += "   "
            if j == 7: caret_str += " "

        ascii_str = ''.join(chr(b) if 32 <= b <= 126 else '.' for b in chunk)
        print(f"{i:08x}: {hex_str:<49} |{ascii_str}|")
        if "^" in caret_str:
            print(f"          {caret_str}")

def find_exact(data, pat):
    """Finds all exact occurrences of a byte pattern."""
    offsets = []
    idx = 0
    while True:
        idx = data.find(pat, idx)
        if idx == -1: 
            break
        offsets.append(idx)
        idx += 1
    return offsets

def find_heuristic(data, pat):
    """Finds the largest contiguous substrings of the pattern in the data."""
    matches = []
    for length in range(len(pat), 0, -1):
        for start in range(len(pat) - length + 1):
            subpat = pat[start:start+length]
            idx = 0
            while True:
                idx = data.find(subpat, idx)
                if idx == -1: 
                    break
                
                covered = False
                for (m_len, m_off, _) in matches:
                    if m_off <= idx <= m_off + m_len - length:
                        covered = True
                        break
                
                if not covered:
                    matches.append((length, idx, subpat))
                idx += 1

    matches.sort(key=lambda x: (-x[0], x[1]))
    if not matches: return []
    top_len = matches[0][0]
    allowed_lengths = {top_len, top_len - 1} if top_len > 1 else {1}
    return [m for m in matches if m[0] in allowed_lengths]

def parse_elf_headers(filepath):
    """Natively parses ELF binaries to map Virtual Addresses to File Offsets and detect Architecture."""
    try:
        with open(filepath, 'rb') as f:
            if f.read(4) != b'\x7fELF': return None
            ei_class = f.read(1)[0]
            ei_data = f.read(1)[0]
            endian = '<' if ei_data == 1 else '>'
            
            f.seek(18)
            e_machine = struct.unpack(endian + 'H', f.read(2))[0]
            
            arch_map = {
                3: 'i386',           # EM_386
                8: 'mips',           # EM_MIPS
                20: 'powerpc',       # EM_PPC
                40: 'arm',           # EM_ARM
                62: 'i386:x86-64',   # EM_X86_64
                183: 'aarch64'       # EM_AARCH64
            }
            arch = arch_map.get(e_machine, 'i386:x86-64')
            
            f.seek(24)
            if ei_class == 1:
                e_entry = struct.unpack(endian + 'I', f.read(4))[0]
                e_phoff = struct.unpack(endian + 'I', f.read(4))[0]
                f.seek(42)
                e_phentsize = struct.unpack(endian + 'H', f.read(2))[0]
                e_phnum = struct.unpack(endian + 'H', f.read(2))[0]
            elif ei_class == 2:
                e_entry = struct.unpack(endian + 'Q', f.read(8))[0]
                e_phoff = struct.unpack(endian + 'Q', f.read(8))[0]
                f.seek(54)
                e_phentsize = struct.unpack(endian + 'H', f.read(2))[0]
                e_phnum = struct.unpack(endian + 'H', f.read(2))[0]
            else: return None
            
            segments = []
            entry_offset = None
            
            if e_phoff == 0: return {'entry_offset': None, 'segments': [], 'arch': arch}
            
            for i in range(e_phnum):
                f.seek(e_phoff + i * e_phentsize)
                if ei_class == 1:
                    p_type = struct.unpack(endian + 'I', f.read(4))[0]
                    p_offset = struct.unpack(endian + 'I', f.read(4))[0]
                    p_vaddr = struct.unpack(endian + 'I', f.read(4))[0]
                    f.read(4)
                    p_filesz = struct.unpack(endian + 'I', f.read(4))[0]
                else:
                    p_type = struct.unpack(endian + 'I', f.read(4))[0]
                    f.read(4)
                    p_offset = struct.unpack(endian + 'Q', f.read(8))[0]
                    p_vaddr = struct.unpack(endian + 'Q', f.read(8))[0]
                    f.read(8)
                    p_filesz = struct.unpack(endian + 'Q', f.read(8))[0]
                    
                if p_type == 1: # PT_LOAD
                    segments.append((p_offset, p_filesz, p_vaddr))
                    if p_vaddr <= e_entry < p_vaddr + p_filesz:
                        entry_offset = e_entry - p_vaddr + p_offset
                        
            return {'entry_offset': entry_offset, 'segments': segments, 'arch': arch}
    except Exception:
        return None

def get_vaddr(elf_info, file_offset):
    """Converts a file offset into a Virtual Address using ELF program headers."""
    if not elf_info: return None
    for p_offset, p_filesz, p_vaddr in elf_info['segments']:
        if p_offset <= file_offset < p_offset + p_filesz:
            return p_vaddr + (file_offset - p_offset)
    return None

def resolve_main_vaddr(filename):
    """Uses objdump symbol table to find the true Virtual Address of <main>."""
    if not shutil.which('objdump'): return None
    cmd = ['objdump', '-t', filename]
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        for line in res.stdout.splitlines():
            # Looks for: "0000000000401166 g     F .text  000000000000008a              main"
            if line.endswith(' main') or line.endswith('\tmain'):
                parts = line.split()
                if len(parts) > 0:
                    return int(parts[0], 16)
    except Exception:
        pass
    return None

def run_objdump_stream(cmd, match_addr_int, size, until_return):
    """Executes objdump and extracts the requested instructions robustly."""
    process = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    count = 0
    started = False
    extracted = []
    
    return_patterns = [
        r'\bret[qnfz]?\b', r'\brepz\s+ret\b', 
        r'\bbx\s+lr\b', r'\bpop\b[^}]*\bpc\b', 
        r'\bjr\s+ra\b'
    ]
    
    try:
        for line in process.stdout:
            if not started:
                match = re.match(r'^\s*([0-9a-fA-F]+)[:\s]', line)
                if match:
                    try:
                        addr = int(match.group(1), 16)
                        if addr >= match_addr_int:
                            started = True
                    except ValueError:
                        pass
            
            if started:
                if not line.strip() or line.startswith('Disassembly') or 'file format' in line:
                    continue
                    
                extracted.append(line.rstrip('\n\r'))
                
                if '\t' in line or '...' in line:
                    count += 1
                    if until_return:
                        if any(re.search(pat, line.lower()) for pat in return_patterns):
                            break
                    else:
                        if count >= size:
                            break
    finally:
        process.terminate()
        process.wait()
        
    return extracted

def disassemble(filename, offset, size, until_return, quiet):
    """Disassembles binary at offset with robust fallback and smart architecture detection."""
    if not shutil.which('objdump'):
        if not quiet: print("Error: 'objdump' not found on system. Cannot disassemble.", file=sys.stderr)
        sys.exit(1)
    
    elf_info = parse_elf_headers(filename)
    vaddr = get_vaddr(elf_info, offset)
    arch = elf_info['arch'] if elf_info else 'i386:x86-64'
    
    intel_flag = ['-M', 'intel'] if ('i386' in arch or 'x86' in arch) else []
    
    extracted = []
    
    if vaddr is not None:
        cmd1 = ['objdump', '-D'] + intel_flag + [f'--start-address={vaddr}', filename]
        extracted = run_objdump_stream(cmd1, vaddr, size, until_return)
        
    if not extracted:
        cmd2 = ['objdump', '-D', '-b', 'binary', '-m', arch] + intel_flag + [f'--start-address={offset}', filename]
        extracted = run_objdump_stream(cmd2, offset, size, until_return)
        
    if not extracted:
        if not quiet: print(f"Failed to disassemble at offset {hex(offset)}. (No instructions found).", file=sys.stderr)
        return
        
    for line in extracted:
        print(line)

def main():
    if len(sys.argv) == 1:
        sys.argv.append('--help')

    parser = argparse.ArgumentParser(description="binpatch - Binary Patching Tool", add_help=False)
    parser.add_argument('file', help="Target file")
    parser.add_argument('-o', '--offset', help="File Offset (Hexadecimal). Auto-translates VMAs.")
    parser.add_argument('-va', '--vaddr', help="Virtual Address (e.g. 401080). Translates to File Offset.")
    parser.add_argument('-e', '--entry', action='store_true', help="Target the ELF Entry Point (_start)")
    parser.add_argument('-m', '--main', action='store_true', help="Target the true 'main()' function (C/C++ binaries)")
    parser.add_argument('-h', '--hex', help="Hex bytes to write (e.g., 'cb 10 00 00 05')")
    parser.add_argument('-b', '--backup', action='store_true', help="Create backup before patching")
    parser.add_argument('-f', '--find', help="Find exact hex pattern in file")
    parser.add_argument('-fh', '--find-heuristic', help="Find largest contiguous substring match")
    parser.add_argument('-d', '--disassemble', action='store_true', help="Disassemble at target offset")
    parser.add_argument('-s', '--size', type=int, default=None, help="Num instructions OR Num find results (Defaults: 1 for disasm, 5 for find)")
    parser.add_argument('-r', '--return', action='store_true', dest='until_return', help="Disassemble until return instruction")
    parser.add_argument('-a', '--all', action='store_true', help="Show all find results (Overrides limit)")
    parser.add_argument('-q', '--quiet', action='store_true', help="Scripting mode: Output raw offsets only")
    parser.add_argument('--help', action='help', help="Show this help message and exit")
    parser.add_argument('--version', action='version', version='binpatch 1.1.0')
    
    args = parser.parse_args()
    
    if not os.path.exists(args.file):
        if not args.quiet: print(f"Error: File '{args.file}' not found.", file=sys.stderr)
        sys.exit(1)
        
    if args.until_return and args.size is not None:
        print("Error: You cannot use both '-s' (size limit) and '-r' (until return) together.", file=sys.stderr)
        sys.exit(1)
        
    # Resolve Offset
    if args.main:
        main_vma = resolve_main_vaddr(args.file)
        if main_vma is None:
            print(f"Error: Could not locate '<main>' symbol in '{args.file}'. Binary may be stripped.", file=sys.stderr)
            sys.exit(1)
            
        elf_info = parse_elf_headers(args.file)
        if not elf_info:
            print(f"Error: Cannot map <main> because '{args.file}' is not a valid ELF.", file=sys.stderr)
            sys.exit(1)
            
        translated = None
        for p_offset, p_filesz, p_vaddr in elf_info['segments']:
            if p_vaddr <= main_vma < p_vaddr + p_filesz:
                translated = p_offset + (main_vma - p_vaddr)
                break
                
        if translated is None:
            print(f"Error: <main> Virtual Address {hex(main_vma)} is not physically mapped in the file.", file=sys.stderr)
            sys.exit(1)
            
        if not args.quiet:
            print(f"[*] Found <main> at Virtual Address {hex(main_vma)} -> File Offset {hex(translated)}")
        offset = translated

    elif args.entry:
        elf_info = parse_elf_headers(args.file)
        if not elf_info or elf_info['entry_offset'] is None:
            print(f"Error: Could not natively parse ELF entry point from '{args.file}'.", file=sys.stderr)
            sys.exit(1)
        if not args.quiet:
            print(f"[*] Found Entry Point at File Offset {hex(elf_info['entry_offset'])}")
        offset = elf_info['entry_offset']

    elif args.vaddr is not None:
        try:
            vaddr = parse_offset(args.vaddr)
        except ValueError as e:
            if not args.quiet: print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)
            
        elf_info = parse_elf_headers(args.file)
        if not elf_info:
            print(f"Error: Cannot translate Virtual Address {hex(vaddr)} because {args.file} is not a valid ELF.", file=sys.stderr)
            sys.exit(1)
            
        translated = None
        for p_offset, p_filesz, p_vaddr in elf_info['segments']:
            if p_vaddr <= vaddr < p_vaddr + p_filesz:
                translated = p_offset + (vaddr - p_vaddr)
                break
                
        if translated is None:
            print(f"Error: Virtual Address {hex(vaddr)} is not mapped in the physical file.", file=sys.stderr)
            sys.exit(1)
            
        if not args.quiet:
            print(f"[*] Mapped Virtual Address {hex(vaddr)} -> File Offset {hex(translated)}")
        offset = translated
        
    elif args.offset is not None:
        try:
            offset = parse_offset(args.offset)
        except ValueError as e:
            if not args.quiet: print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)
            
        file_size = os.path.getsize(args.file)
        if offset >= file_size:
            elf_info = parse_elf_headers(args.file)
            if elf_info:
                for p_offset, p_filesz, p_vaddr in elf_info['segments']:
                    if p_vaddr <= offset < p_vaddr + p_filesz:
                        translated = p_offset + (offset - p_vaddr)
                        if not args.quiet:
                            print(f"[*] Auto-translated VMA {hex(offset)} -> File Offset {hex(translated)}")
                        offset = translated
                        break
    else:
        offset = None
        
    if not (args.find or args.find_heuristic or offset is not None):
        parser.print_help()
        sys.exit(1)

    disasm_size = args.size if args.size is not None else 1
    find_limit = float('inf') if args.all else (args.size if args.size is not None else 5)

    if args.find or args.find_heuristic:
        with open(args.file, 'rb') as f:
            data = f.read()

        if args.find:
            try:
                pat = parse_hex(args.find)
            except Exception as e:
                if not args.quiet: print(f"Error parsing hex: {e}", file=sys.stderr)
                sys.exit(1)
                
            offsets = find_exact(data, pat)
            if not offsets:
                if not args.quiet: print("Match not found.")
                sys.exit(1)
                
            total = len(offsets)
            show_count = min(total, find_limit)
            
            for off in offsets[:show_count]:
                if args.quiet:
                    print(hex(off))
                else:
                    print(f"Found at File Offset {hex(off)}:")
                    print_hexdump(data, off, len(pat))
                    print()
            
            if total > show_count and not args.quiet:
                print(f"... and {total - show_count} more hidden. Use -a/--all to show all, or -s to change limit.")
            sys.exit(0)
            
        if args.find_heuristic:
            try:
                pat = parse_hex(args.find_heuristic)
            except Exception as e:
                if not args.quiet: print(f"Error parsing hex: {e}", file=sys.stderr)
                sys.exit(1)
                
            matches = find_heuristic(data, pat)
            if not matches:
                if not args.quiet: print("No heuristic matches found.")
                sys.exit(1)
                
            total = len(matches)
            show_count = min(total, find_limit)
            first = True
            
            for i in range(show_count):
                m_len, m_off, m_pat = matches[i]
                if args.quiet:
                    print(hex(m_off))
                else:
                    if first:
                        print(f"Largest match: {m_len} bytes at File Offset {hex(m_off)}")
                        first = False
                    else:
                        print(f"Also found {m_len} bytes at File Offset {hex(m_off)}: {' '.join(f'{b:02x}' for b in m_pat)}")
                    print_hexdump(data, m_off, m_len)
                    print()
            
            if total > show_count and not args.quiet:
                print(f"... and {total - show_count} more heuristic chunks hidden. Use -a/--all to show all.")
            sys.exit(0)

    if offset is not None:
        if args.hex:
            try:
                write_bytes = parse_hex(args.hex)
            except Exception as e:
                if not args.quiet: print(f"Error parsing hex: {e}", file=sys.stderr)
                sys.exit(1)
                
            if args.backup:
                ts = datetime.datetime.now().strftime('%Y%m%d_%H%M%S')
                backup_name = f"backup_{ts}_{os.path.basename(args.file)}"
                shutil.copy2(args.file, backup_name)
                if not args.quiet: print(f"Backup created: {backup_name}")
                
            try:
                file_size = os.path.getsize(args.file)
                if offset >= file_size:
                    if not args.quiet: print(f"Warning: Write offset {hex(offset)} is beyond the end of the file.", file=sys.stderr)
                elif offset + len(write_bytes) > file_size:
                    if not args.quiet: print(f"Warning: Write operation extends beyond the end of the file.", file=sys.stderr)

                with open(args.file, 'r+b') as f:
                    f.seek(offset)
                    f.write(write_bytes)
                if not args.quiet: print(f"Successfully wrote {len(write_bytes)} bytes at File Offset {hex(offset)}.\n")
            except Exception as e:
                if not args.quiet: print(f"Error writing to file: {e}", file=sys.stderr)
                sys.exit(1)

        if args.disassemble:
            if not args.quiet: print(f"Disassembly at File Offset {hex(offset)}:")
            disassemble(args.file, offset, disasm_size, args.until_return, args.quiet)

if __name__ == '__main__':
    main()
